# Shared secret between the bridge and this server. Must match
# AGENT_SHARED_SECRET in imessage-chatbot/.env.local.
AGENT_SHARED_SECRET=

# Groq keys, comma-separated. Each key is one slot in the pool; the server
# stays on one until it is rate limited, then moves to the next.
# Leave empty to run with the built-in fake model (no network, no quota).
GROQ_API_KEYS=

# Who may talk to the agent: phone numbers or emails, comma-separated.
# Leave empty and the first person to text it becomes the owner.
OWNER_IDS=

# Time zone used when the agent talks about dates and times. Defaults to the
# machine's zone, which is UTC on most cloud VMs, so set it there.
# TIMEZONE=America/New_York

# --- Optional -------------------------------------------------------------
# PORT=8787
# HOST=127.0.0.1
# DATA_DIR=../data
# AGENT_NAME=Sage
# DEBOUNCE_MS=2500
# REMINDER_NUDGE_MINUTES=30   # one follow-up if a reminder gets no reaction; 0 turns it off
# QUIET_FROM=22               # no nudges between these local hours
# QUIET_TO=8
# LLM_MODE=fake            # force the fake model even when keys are set
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# MODELS_CHAT=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.8-27b
# MODELS_TOOLS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
# MODELS_VISION=qwen/qwen3.8-27b
# MODELS_SEARCH=openai/gpt-oss-20b,openai/gpt-oss-120b

# --- Optional integrations (off unless named here AND given credentials) ----
# Copies reminders and list items into Todoist and/or Notion. See the README.
# INTEGRATIONS=todoist,notion
# TODOIST_TOKEN=
# NOTION_TOKEN=
# NOTION_DATABASE_ID=
# NOTION_TITLE_PROPERTY=Name
# NOTION_DATE_PROPERTY=
