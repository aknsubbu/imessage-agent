[Unit]
Description=iMessage bridge (Spectrum)
After=network-online.target agent-server.service
Wants=network-online.target

[Service]
User=agent
WorkingDirectory=/opt/imessage-agent/imessage-chatbot
ExecStart=/opt/imessage-agent/imessage-chatbot/node_modules/.bin/tsx --env-file=.env --env-file=.env.local src/index.ts
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/imessage-agent/data

[Install]
WantedBy=multi-user.target
